cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
.env.example

# Node
node_modules/
.next/
out/
dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Data
data/raw/
data/cache/
*.parquet
*.csv

# Model weights / caches
models/**/weights/
models/**/checkpoints/
models/**/cache/
.huggingface/
.cache/
*.safetensors
*.bin

# Logs
*.log
logs/

# Secrets
*.pem
*.key

# Temporary
tmp/
temp/
EOF